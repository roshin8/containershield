{
  "manifest_version": 2,
  "name": "Container Shield",
  "version": "0.3.0",
  "description": "Per-container fingerprint spoofing and privacy protection for Firefox Multi-Account Containers. Protects 50+ fingerprinting APIs.",

  "author": "Container Shield Contributors",
  "homepage_url": "https://github.com/roshin8/containershield",

  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg",
    "128": "icons/icon-128.svg"
  },

  "permissions": [
    "contextualIdentities",
    "cookies",
    "tabs",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "privacy",
    "notifications",
    "contextMenus",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background/index.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "web_accessible_resources": [
    "inject/index.js",
    "pages/ip-warning.html",
    "icons/*.svg"
  ],

  "browser_action": {
    "default_icon": {
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    },
    "default_title": "Container Shield",
    "default_popup": "popup/index.html"
  },

  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },

  "commands": {
    "toggle-protection": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Toggle fingerprint protection for current container"
    },
    "rotate-fingerprint": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Rotate fingerprint for current container"
    },
    "toggle-site-exception": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Toggle protection exception for current site"
    },
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open Container Shield popup"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "containershield@example.com",
      "strict_min_version": "91.0"
    }
  }
}
